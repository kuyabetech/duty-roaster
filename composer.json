{
    "name": "adps/automated-duty-processing-system",
    "description": "Automated Duty Processing System for Educational Institutions",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^7.4|^8.0",
        "dompdf/dompdf": "^2.0",
        "nesbot/carbon": "^2.68",
        "phpmailer/phpmailer": "^7.1",
        "tecnickcom/tcpdf": "^6.6",
        "vlucas/phpdotenv": "^5.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "ADPS\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
